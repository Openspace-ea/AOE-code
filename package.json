{
  "name": "@aoe/client",
  "version": "1.0.0",
  "private": true,
  "description": "AOE Code 客户端工作区（CLI + Desktop + Browser）",
  "scripts": {
    "dev:cli": "pnpm --filter @aoe/cli dev",
    "dev:desktop": "pnpm --filter @aoe/desktop dev",
    "dev:browser": "pnpm --filter @aoe/browser dev",
    "build:cli": "pnpm --filter @aoe/cli build",
    "build:desktop": "pnpm --filter @aoe/desktop build",
    "build:browser": "pnpm --filter @aoe/browser build",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
