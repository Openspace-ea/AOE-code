# ──────────────────────────────────────
# AOE Code Web 环境变量配置
# ──────────────────────────────────────
# 复制本文件为 .env 并修改为实际值

# 应用主页地址（顶栏「主页」跳转）
VITE_HOME_URL=http://localhost:3000

# 后端代理目标（仅 dev 环境生效，生产由反向代理处理）
VITE_API_PROXY_TARGET=http://localhost:8080

# 登录页地址（留空使用默认 aoecode.cn/login）
# VITE_LOGIN_URL=http://localhost:3000/login

# TLE 数据源地址（卫星轨道数据）
# VITE_TLE_DATA_URL=https://ssa.aseem.cn/TLE.json

# TLE 代理地址（用于解决 CORS 问题）
# VITE_TLE_PROXY_URL=/tle-proxy/TLE.json
